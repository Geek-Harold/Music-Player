{
  "name": "music-player",
  "productName": "SONA",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:server:watch\" \"vite\"",
    "server": "node server/index.js",
    "server:watch": "node --watch server/index.js",
    "start": "vite build && node server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "express": "^5.3.0",
    "lucide-react": "^1.51.0",
    "music-metadata": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.sona.player",
    "productName": "SONA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "server/api.js",
      "server/library.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
